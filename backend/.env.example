POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=your-postgres-db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public
ANTHROPIC_API_KEY=your_anthropic_api_key
PORT=3000

# --- Local model (Ollama) ---
# Both default to the coder below if unset, so the app works with one model.
OLLAMA_HOST=http://localhost:11434
# Agentic reasoning: exploring the app, planning cases, analysing failures.
# Measured: qwen3:8b reaches a login goal 3/3; the coder model 0/3.
OLLAMA_REASONING_MODEL=qwen3:8b
# Writing the Playwright spec. The coder model compiles 6/6 eval cases.
OLLAMA_CODEGEN_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
# Thinking cost 5x latency for an identical answer when measured, so it is off.
# Only set either to true on a model that supports thinking (e.g. qwen3) —
# Ollama rejects think:true on other models rather than ignoring it.
OLLAMA_THINK_EXPLORE=false
OLLAMA_THINK_PLAN=false
