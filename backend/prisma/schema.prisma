// Prisma schema defining two simple models used to persist agent runs and
// individual test case metadata. This project is configured for a local
// PostgreSQL instance via DATABASE_URL.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AgentRun {
  id         String    @id @default(uuid())
  prdText    String
  baseUrl    String
  status     String
  message    String?
  provider   String?
  model      String?
  testPlan   Json?
  flowTrace  Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  testCases  TestCase[]
}

model TestCase {
  id          String   @id @default(uuid())
  runId       String
  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  externalId  String
  description String
  type        String
  status      String
  errorLog    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Accepted (prompt, output) pairs from whichever backend served a run.
/// While a funded API key is present these rows accumulate as a distillation
/// corpus for fine-tuning a local model later; capture is cheap, and a corpus
/// not collected cannot be collected retroactively.
model LlmCallLog {
  id        String   @id @default(uuid())
  runId     String?
  provider  String
  model     String
  kind      String
  prompt    String
  output    String
  createdAt DateTime @default(now())

  @@index([provider, kind])
}
